{
  "name": "jira-dev-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for Jira Cloud-driven development workflows",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jira-mcp-server": "dist/index.js",
    "jira-mcp-login": "dist/login.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "jira",
    "mcp",
    "model-context-protocol",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
